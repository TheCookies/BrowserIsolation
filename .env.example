# Copy this file to .env before running podman compose / docker compose.
# Values below are for local HTTP. Set COOKIE_SECURE=true behind TLS.
#
# Podman (default in docker-compose.yml): CONTAINER_SOCKET=/run/podman/podman.sock
# Docker Engine: CONTAINER_SOCKET=/var/run/docker.sock
# Production remote auto-start: see docs/PODMAN.md and deploy/podman/.

# --- Portal ---
# Host port published by Docker Compose. Inside the container the app always listens on 8080.
PORT=8080
# Display name in the portal header, login page, and browser tab (also editable in Admin → Settings).
SITE_NAME=Browser Isolation
# Set true when a reverse proxy sends X-Forwarded-* headers.
TRUST_PROXY=false
# Secure cookies are not stored by browsers on plain HTTP. Use false for local HTTP,
# and true when the portal is served over HTTPS.
COOKIE_SECURE=false
# Portal login lifetime in hours.
SESSION_TTL_HOURS=24
# bcrypt cost used when hashing AUTH_USERS at startup.
BCRYPT_ROUNDS=12
# SQLite file. Docker Compose overrides this to /data/rbi.sqlite.
# Relative paths are resolved from the repository root.
DATABASE_PATH=./data/rbi.sqlite

# Bootstrap seed for local accounts (used only when the database has zero users).
# After first start, manage accounts in Admin → Users. Format: username:password:role.
# Usernames: letters, digits, dot, underscore, at-sign, hyphen.
AUTH_USERS=admin:admin:admin,user:user:user

# --- SSO / SAML (also configurable in Admin → Settings → SSO / SAML) ---
# Leave disabled until PUBLIC_BASE_URL, IdP SSO URL, and IdP certificate are set.
SAML_ENABLED=false
# Canonical portal origin used in ACS + SP metadata (e.g. https://rbi.example.com).
# PUBLIC_BASE_URL=https://rbi.example.com
# SAML_ENTRY_POINT=https://login.microsoftonline.com/<tenant>/saml2
# SAML_IDP_ENTITY_ID=
# SAML_IDP_CERT=
# SAML_SP_ENTITY_ID=
# SAML_USERNAME_ATTR=
# SAML_GROUPS_ATTR=
# Group/value that grants admin on SSO login (case-insensitive).
# SAML_ADMIN_GROUP=

# --- Browser containers ---
# Comma-separated Neko browser ids. After first Admin → Browsers save, DB overrides this.
# Full catalog: firefox,tor-browser,waterfox,chromium,google-chrome,ungoogled-chromium,
# microsoft-edge,brave,vivaldi,opera
ENABLED_BROWSERS=google-chrome,firefox,brave
# Tag for ghcr.io/m1k1o/neko/<browser>:<tag>. Prefer latest; use Admin → Pull latest.
NEKO_IMAGE_TAG=latest
# Optional override of managed browser policies (default: orchestrator/neko-policies).
# Policies remove Neko's force-installed SponsorBlock; uBlock Origin remains.
# NEKO_POLICIES_DIR=/absolute/path/to/neko-policies
# Allow users to opt into persistent browser profiles (per subjectId / Docker volume).
# See docs/USER_IDENTITY.md for SAML-ready ownership keys.
PERSIST_PROFILES_ENABLED=true
# Security: clipboard sync and file transfer are off by default (Admin → Settings → Security).
ALLOW_CLIPBOARD=false
ALLOW_DOWNLOADS=false

# --- Multi-host workers ---
# When true (default), this host also creates browsers via the local engine (single-node).
# Set false on a control-plane-only host when all browsers run on remote workers.
LOCAL_WORKER_ENABLED=true
# Shared secret for worker self-enrollment (POST /api/workers/enroll).
# Also used as the Bearer token for orchestrator → worker agent API calls.
# Must match deploy/podman/install-worker.sh on every worker host.
WORKER_ENROLL_TOKEN=rbi_enroll_k9m2Vx7Qp4Hs8nWc3YfL6tZa1Bd0EgR5
# GitHub classic PAT with read:packages (local/dev GHCR pulls). Do not commit real values.
# GHCR_USER=YourGitHubUsername
# GHCR_TOKEN=ghp_replace_me
# Worker agent process (podman compose --profile worker / worker Quadlet):
# WORKER_ID=edge1
# WORKER_TOKEN=<same as WORKER_ENROLL_TOKEN>
# ORCHESTRATOR_URL=http://orchestrator:8080
# WORKER_PORT=8090
# Bootstrap remote workers at startup (also manageable in Admin → Workers):
# id|http://agent:8090|publicIp|token,id2|http://...|ip2|token2
# WORKERS=edge1|http://10.0.0.5:8090|10.0.0.5|rbi_enroll_k9m2Vx7Qp4Hs8nWc3YfL6tZa1Bd0EgR5
BROWSER_NETWORK=rbi-browsers
# bridge = custom network + published ports (Docker Compose default)
# host = share host network namespace (use for Podman/Hyper-V when TCP/UDP publish fails)
BROWSER_NETWORK_MODE=bridge
BROWSER_SHM_SIZE=2gb
# Docker NanoCPUs are derived from this number (1 = one CPU). Use 3+ for smoother video.
BROWSER_CPUS=3
# Docker memory limit, for example 2g or 512m.
BROWSER_MEMORY=2g
# Path to the container engine socket *inside* the orchestrator/worker container.
# Compose/Quadlet mount the host Podman (or Docker) socket at this path.
DOCKER_SOCKET=/var/run/docker.sock
# Public address advertised in WebRTC candidates. Required when launching a browser.
# Use 127.0.0.1 for a browser on this machine, or the host's LAN/public IP otherwise.
PUBLIC_IP=127.0.0.1
# One host port per browser container, UDP mux and TCP mux (same port number, both protocols).
WEBRTC_PORT_RANGE=52000-52099
# ICE lite matches the single published mux port. Set false when ICE servers (TURN) are configured.
WEBRTC_ICELITE=true
# JSON arrays of RTCIceServer objects, passed through to Neko.
# Example: [{"urls":["turn:turn.example.com:3478"],"username":"rbi","credential":"secret"}]
# Leave as [] until a TURN server is added. TURN requires WEBRTC_ICELITE=false.
ICE_SERVERS_FRONTEND=[]
ICE_SERVERS_BACKEND=[]
# Desktop capture size@fps (e.g. 1920x1080@30 or 1280x720@30).
# Cold-start baseline; the viewer sends screen/set to match the client viewport.
DESKTOP_SCREEN=1280x720@30
# WebRTC video codec: h264 (default) or vp8.
CAPTURE_VIDEO_CODEC=h264

# --- Cleanup ---
# Destroy sessions with zero connected viewers after this many minutes.
IDLE_TIMEOUT_MINUTES=60
# Hard max lifetime for any browser session, hours.
MAX_SESSION_HOURS=12
# How often the background reaper scans, seconds.
REAPER_INTERVAL_SECONDS=60
