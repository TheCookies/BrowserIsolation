# Copy this file to .env before running docker compose.
# Values below are for local HTTP. Set COOKIE_SECURE=true behind TLS.

# --- Portal ---
# Host port published by Docker Compose. Inside the container the app always listens on 8080.
PORT=8080
# Set true when a reverse proxy sends X-Forwarded-* headers.
TRUST_PROXY=false
# Secure cookies are not stored by browsers on plain HTTP. Use false for local HTTP,
# and true when the portal is served over HTTPS.
COOKIE_SECURE=false
# Portal login lifetime in hours.
SESSION_TTL_HOURS=24
# bcrypt cost used when hashing AUTH_USERS at startup.
BCRYPT_ROUNDS=12
# SQLite file. Docker Compose overrides this to /data/rbi.sqlite.
# Relative paths are resolved from the repository root.
DATABASE_PATH=./data/rbi.sqlite

# Bootstrap seed for local accounts (used only when the database has zero users).
# After first start, manage accounts in Admin → Users.
AUTH_USERS=admin:admin:admin,user:user:user

# --- Browser containers ---
# Comma-separated Neko browser ids (Admin → Browsers overrides this after first save).
ENABLED_BROWSERS=google-chrome,firefox,brave
# Tag for ghcr.io/m1k1o/neko/<browser>:<tag>. Use "latest" with Admin → Pull latest.
NEKO_IMAGE_TAG=latest
PERSIST_PROFILES_ENABLED=true
ALLOW_CLIPBOARD=false
ALLOW_DOWNLOADS=false
LOCAL_WORKER_ENABLED=true
BROWSER_NETWORK=rbi-browsers
BROWSER_SHM_SIZE=2gb
# Docker NanoCPUs are derived from this number (1 = one CPU). YouTube needs ~2+.
BROWSER_CPUS=3
# Docker memory limit, for example 2g or 512m.
BROWSER_MEMORY=2g
# Public address advertised in WebRTC candidates. Required when launching a browser.
# Use 127.0.0.1 for a browser on this machine, or the host's LAN/public IP otherwise.
PUBLIC_IP=192.168.113.148
# One host port per browser container, UDP mux and TCP mux.
WEBRTC_PORT_RANGE=52000-52099
# ICE lite matches the single published mux port. Set false when ICE servers (TURN) are configured.
WEBRTC_ICELITE=true
# JSON arrays of RTCIceServer objects, passed through to Neko.
# Example: [{"urls":["turn:turn.example.com:3478"],"username":"rbi","credential":"secret"}]
# Leave as [] until a TURN server is added. TURN requires WEBRTC_ICELITE=false.
ICE_SERVERS_FRONTEND=[]
ICE_SERVERS_BACKEND=[]
# Desktop capture size@fps (e.g. 1920x1080@30 or 1280x720@30).
# Cold-start baseline; the viewer sends screen/set to match the client viewport.
DESKTOP_SCREEN=1280x720@30
# WebRTC video codec: vp8 (reliable) or h264 (experimental on software encode).
CAPTURE_VIDEO_CODEC=vp8

# --- Cleanup (used in a later phase) ---
IDLE_TIMEOUT_MINUTES=60
MAX_SESSION_HOURS=12
REAPER_INTERVAL_SECONDS=60

DOCKER_SOCKET=/var/run/docker.sock
